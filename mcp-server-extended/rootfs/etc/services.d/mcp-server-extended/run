#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant MCP Extended Server
# ==============================================================================

declare ha_url
declare ha_token
declare log_level

# Get configuration options
ha_url=$(bashio::config 'ha_url')
ha_token=$(bashio::config 'ha_token')
log_level=$(bashio::config 'log_level' 'info')

# Export environment variables. Neither has a default in the binary: HA_URL used
# to fall back to an unencrypted, guessed host, which silently sent the bearer
# token somewhere the user never named.
export HA_URL="${ha_url}"
export HA_TOKEN="${ha_token}"
export LOG_LEVEL="${log_level}"

# Log startup
bashio::log.info "Starting MCP Server Extended..."
bashio::log.info "HA URL: ${ha_url}"
bashio::log.info "Log Level: ${log_level}"

if [ -z "${ha_url}" ]; then
    bashio::log.error "HA_URL is not set! Please configure it in the addon options."
    exit 1
fi

if [ -z "${ha_token}" ]; then
    bashio::log.error "HA_TOKEN is not set! Please configure it in the addon options."
    exit 1
fi

# Run the MCP server. It speaks MCP on stdin/stdout and logs to stderr.
exec /usr/bin/mcp-ha-extended
